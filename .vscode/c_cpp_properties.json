{
  "env": {
    "myIncludePath": [
      "${workspaceFolder}\\include",
      "${workspaceFolder}\\src"
    ],
    "myDefines": [
      "DEBUG",
      "MY_FEATURE=1"
    ]
  },
  "configurations": [
    {
      "name": "windows-gcc-x86",
      "compilerPath": "C:/MinGW/bin/gcc.exe",
      "intelliSenseMode": "windows-gcc-x86",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}\\include"
      ],
      "defines": [
        "${myDefines}",
        "_WINDOWS"
      ],
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "browse": {
        "path": [
          "${myIncludePath}",
          "${workspaceFolder}"
        ]
      }
    }
  ],
  "version": 4,
  "enableConfigurationSquiggles": true
}